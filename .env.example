# CityPulse 2.0 Environment Variables
# Copy this file to .env and fill in your API keys

# SerpApi (MANDATORY for hackathon - 25% of judging)
# Get 500 free credits at: https://serpapi.com/beyond9to5mumbai500
SERPAPI_KEY=your_serpapi_key_here

# Google Gemini API (for AI recommendations and briefings)
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Open-Meteo (optional - for higher rate limits)
# OPENMETEO_API_KEY=your_openmeteo_key_here

# Streamlit Secrets (alternative to .env)
# Add these to .streamlit/secrets.toml instead:
# SERPAPI_KEY = " your_key\
# GEMINI_API_KEY = \your_key\
